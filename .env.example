# Code Court VS Code Extension - Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
# Default: Production API
CODECOURT_API_URL=https://www.codecourt.dev

# Development: Use local API
# CODECOURT_API_URL=http://localhost:3000

# OAuth2 Configuration (Phase 2)
# These will be needed when implementing authentication
# CODECOURT_CLIENT_ID=your_vscode_client_id
# CODECOURT_CLIENT_SECRET=your_vscode_client_secret

# Extension Configuration
# Development mode (enables additional logging)
NODE_ENV=development

# VS Code Extension ID (for OAuth redirect)
EXTENSION_ID=codecourt.codecourt
